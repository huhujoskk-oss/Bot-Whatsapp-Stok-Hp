# ==== Konfigurasi Bot Stok Vivo ====

# ID grup WhatsApp target. Kosongkan dulu saat pertama kali.
# Cara mendapatkan: jalankan bot, scan QR, lalu ketik "#id" di grup target.
# Bot akan membalas ID-nya (format: 62xxxx-1600000000@g.us). Salin ke sini.
GROUP_ID=

# Nomor WhatsApp bot ini sendiri, kode negara + nomor tanpa "+"/0 di depan.
# Diisi -> login pakai KODE PAIRING (tanpa scan QR, cocok kalau susah scan lewat SSH).
# Dikosongkan -> login seperti biasa, scan QR yang muncul di terminal.
# Contoh: BOT_NUMBER=6281234567890
BOT_NUMBER=

# Nomor admin (boleh #tambah / #hapus). Pisahkan dengan koma, pakai kode negara.
# Contoh: ADMINS=6281234567890,628987654321
ADMINS=

# Prefix perintah (default: #)
PREFIX=#

# true  = cukup ketik IMEI di grup -> otomatis tercatat terjual
# false = penjualan hanya lewat perintah "#jual <imei>"
AUTO_DETECT_IMEI=true

# Balas konfirmasi di grup setelah tiap transaksi (true/false)
REPLY_IN_GROUP=true

# Daftar nama toko/cabang yang valid untuk "#tambah". Pisah dengan koma.
STORES=Carpus,Carten,Kaba,Pasar
